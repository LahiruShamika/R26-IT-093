    "description": "Complete API collection for the AI/ML-Powered Smart Farm project.\n\n**Two servers:**\n- Flask (AI/ML): http://localhost:5000\n- Laravel (Data/Auth): http://localhost:8000/api\n\n**After login, copy the token into the `token` collection variable.**",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "flask_url",   "value": "http://localhost:5000",      "type": "string" },
    { "key": "laravel_url", "value": "http://localhost:8000/api",  "type": "string" },
    { "key": "token",       "value": "",                           "type": "string" },
    { "key": "cow_id",      "value": "1",                         "type": "string" }
